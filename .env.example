# Mini-GitOps Environment Configuration Example
# Copy this file to .env and adjust the settings as needed:
# cp .env.example .env

# Shared secret for verifying GitHub HMAC-SHA256 signatures (X-Hub-Signature-256)
WEBHOOK_SECRET=supersecretkey123

# Git repository URL containing declarative application manifests
GIT_REPO_URL=https://github.com/example/mini-gitops-manifests.git

# Target Git branch to pull manifests from
REPO_BRANCH=main

# Local directory where the Git repository will be cloned
LOCAL_REPO_DIR=/tmp/gitops-repo

# Health check / Readiness probe settings (in seconds)
HEALTHCHECK_TIMEOUT_SEC=30
HEALTHCHECK_INTERVAL_SEC=2
